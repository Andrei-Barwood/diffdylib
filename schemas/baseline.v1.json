{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyld87.local/schemas/baseline.v1.json",
  "title": "dyld87.baseline.v1",
  "description": "Expected dylib set for one application capture. Differential protection baseline, not a malware verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "app_path",
    "captured_at",
    "dylibs",
    "notes"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "dyld87.baseline.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier referenced by diff reports as baseline_id."
    },
    "app_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path of the host application or main executable."
    },
    "signing_id": {
      "type": ["string", "null"],
      "description": "Host code-signing identifier, if known."
    },
    "team_id": {
      "type": ["string", "null"],
      "description": "Host Team ID (nameplate). Never treated as a malware label."
    },
    "binary_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "SHA-256 of the main Mach-O. Natural-key field content_hash_of_main_binary."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Store revision for the natural key (process_signing_id, app_path, binary hash)."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with optional fractional seconds."
    },
    "dylibs": {
      "type": "array",
      "items": { "$ref": "#/$defs/dylibIdentity" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "dylibOrigin": {
      "type": "string",
      "enum": ["staticDependency", "rpathCandidate", "runtimeMapping"]
    },
    "sipState": {
      "type": "string",
      "enum": ["protected", "unprotected", "unknown"]
    },
    "signingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["unsigned", "valid", "invalid", "error"]
        },
        "message": { "type": "string" }
      }
    },
    "dylibIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "writable_by_user", "origin"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Install name or observed path (may contain @rpath)."
        },
        "resolved_path": {
          "type": ["string", "null"],
          "description": "Absolute path after conservative resolution."
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "Hex SHA-256 of the on-disk file, if hashed."
        },
        "team_id": {
          "type": ["string", "null"]
        },
        "signing_id": {
          "type": ["string", "null"]
        },
        "authority": {
          "type": ["string", "null"],
          "description": "Leaf certificate subject summary. Not a malware label."
        },
        "notarized": {
          "type": ["boolean", "null"],
          "description": "Offline/stapled evidence only. null = not determined (no network)."
        },
        "signing_state": {
          "description": "unsigned is a nameplate, not malware.",
          "anyOf": [
            { "$ref": "#/$defs/signingState" },
            { "type": "null" }
          ]
        },
        "posix_permissions": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 65535,
          "description": "st_mode bits as UInt16."
        },
        "uid": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "gid": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "owner": {
          "type": ["string", "null"],
          "description": "File owner as user:group or username."
        },
        "writable_by_user": {
          "type": "boolean",
          "description": "Effective user can write the file or its parent directory."
        },
        "sip": {
          "description": "Approximation from UF_RESTRICTED/SF_RESTRICTED. unknown if lstat failed.",
          "anyOf": [
            { "$ref": "#/$defs/sipState" },
            { "type": "null" }
          ]
        },
        "origin": { "$ref": "#/$defs/dylibOrigin" }
      }
    }
  }
}
